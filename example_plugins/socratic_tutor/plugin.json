{
  "name": "Socratic Tutor",
  "version": "1.0.0",
  "author": "CogniCraft Team",
  "description": "Dạy bằng câu hỏi Socratic - không đưa đáp án",
  "category": "AI Tools",
  "license": "MIT",
  "homepage": "https://cognicraft.io/plugins/socratic",
  "repository": "https://github.com/cognicraft/socratic-tutor",

  "requires": [
    "cognicraft-core>=2.0.0",
    "ai-service>=1.0.0"
  ],

  "permissions": [
    "read:scores",
    "write:insights",
    "send:messages",
    "call:ai"
  ],

  "commands": [
    {
      "name": "socratic",
      "description": "Bắt đầu Socratic session",
      "handler": "start_socratic"
    },
    {
      "name": "answer",
      "description": "Trả lời câu hỏi Socratic",
      "handler": "answer_question"
    }
  ],

  "hooks": {
    "on_score_complete": "auto_recommend",
    "on_weekly_report": "add_summary"
  },

  "config": {
    "max_turns": {
      "type": "integer",
      "default": 5,
      "description": "Số câu hỏi tối đa"
    },
    "model": {
      "type": "string",
      "default": "gemini-flash-lite-latest",
      "description": "AI model sử dụng"
    }
  },

  "entry_point": "main.py",
  "main_class": "SocraticTutorPlugin"
}